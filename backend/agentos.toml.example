# OPTIONAL, SEED-ONLY. AgentOS needs no config file: everything here is edited in the app by
# admins (Settings) and stored in the database. If a backend/agentos.toml (or AGENTOS_CONFIG)
# exists, it is read only to seed settings the database doesn't have yet (the very first start,
# or the first start after an upgrade that added a Settings tab); without one, built-in defaults
# seed them. After that it is ignored (the server logs a warning while it's still there): delete
# it. Every table is optional. Top-level keys (default_runtime) must stay above the first table.

# Settings > Runners (runtimes): argv templates; placeholders replace whole elements (except
# {session}, which may be part of one), no shell. default_runtime is listed first (the server
# default); without it, the first table is. session_args / resume_args / verdict_args /
# verdict_from serve loop blocks (sessions, and where a check's verdict is read). Without any
# [runtimes.*], these two built-ins seed:
# default_runtime = "claude"
# [runtimes.claude]
# argv = ["claude", "-p", "--output-format", "stream-json", "--verbose", "--permission-mode", "bypassPermissions"]
# model_args = ["--model", "{model}"]
# effort_args = ["--effort", "{effort}"]
# agent_args = ["--agent", "{agent}"]
# prompt_via = "stdin"
# session_args = ["--session-id", "{session}"]
# resume_args = ["--resume", "{session}"]
# verdict_args = ["--json-schema", "{verdict_schema}"]
# verdict_from = "structured_output"
# [runtimes.copilot]
# argv = ["copilot", "--allow-all", "--no-ask-user", "--output-format", "json"]
# model_args = ["--model", "{model}"]
# effort_args = ["--effort", "{effort}"]
# agent_args = ["--agent", "{agent}"]
# prompt_via = "arg"
# prompt_args = ["-p", "{prompt}"]
# session_args = ["--resume={session}"]
# resume_args = ["--resume={session}"]
# verdict_from = "file"

# Settings > Space. Zero [[repos]] is valid (no-repo tickets only).
# [space]
# name = "AgentOS"           # shown in the top bar; default "AgentOS"
# default_repo = "agentos"   # what a new ticket gets when it names no repo; must be a [[repos]] name
#
# [[repos]]
# name = "agentos"           # ^[a-z0-9][a-z0-9._-]{0,63}$, unique
# url = "https://github.com/your-org/your-repo.git"   # https://..., ssh://... or git@host:path
#                                                     # (GitHub Actions runners: https)
# default_branch = "main"    # default "main"

# Settings > Intake: the Intake tab lists the Jira issues each query matches that aren't in
# AgentOS yet, with "Take in" (= import).
# [[intake.queries]]
# id = "scrum-todo"          # ^[a-z0-9][a-z0-9_-]{0,63}$, unique
# name = "SCRUM: to do"      # shown in the tab
# jql = 'project = SCRUM AND statusCategory = "To Do"'
