# Copy to backend/.env. The server runs from backend/, so relative paths resolve from there.
# Every server setting is AGENTOS_-prefixed (the local launcher strips them from worker env).
AGENTOS_DATA_DIR=./data  # → backend/data (gitignored)
# Must be outside DATA_DIR and outside any git repo. Default: ~/.agentos/workspaces
# AGENTOS_WORKSPACES_DIR=
AGENTOS_PUBLIC_URL=http://127.0.0.1:8000
AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=8000
AGENTOS_CONFIG=agentos.toml
# The Space (name, key prefix, Jira projects, claim timeout), its repos and intake queries are
# edited in the app (Settings), not here. AGENTOS_KEY_PREFIX, AGENTOS_JIRA_PROJECTS and
# AGENTOS_CLAIM_TIMEOUT_S moved there: if still set, they only seed Settings > Space on the very
# first start, and are otherwise ignored with a warning.
AGENTOS_LAUNCHER=local
# AGENTOS_LAUNCHER=github: one workflow dispatch per run (backend/deploy/README.md).
# AGENTOS_GITHUB_REPO=DiwashRai/AgentOS
# AGENTOS_GITHUB_REF=main
# AGENTOS_GITHUB_WORKFLOW=agentos-worker.yml
# AGENTOS_GITHUB_TOKEN=
AGENTOS_LOCAL_MAX_CONCURRENCY=2
# Dotenv file applied to worker env after stripping AGENTOS_* (e.g. ANTHROPIC_API_KEY, GH_TOKEN).
AGENTOS_WORKER_ENV_FILE=

# Weekend: dev auth only (requires loopback HOST and PUBLIC_URL).
AGENTOS_DEV_AUTH=1

# Jira auth (when AGENTOS_DEV_AUTH is off). People sign in with their Jira credentials
# (Cloud: email + classic API token; Data Center: a PAT) and need browse access to at least one
# of the Space's Jira projects (Settings > Space; AGENTOS_ADMINS people only need a valid token).
# A first login waits for an admin to approve it (role `pending`).
AGENTOS_JIRA_URL=
AGENTOS_JIRA_DEPLOYMENT=cloud
# Jira import (POST /api/tickets/import; works with dev auth too): the service account the server
# reads issues with. Cloud: its email + a classic API token; Data Center: a PAT (no email).
# Needs AGENTOS_JIRA_URL. Leave both empty to turn import off.
AGENTOS_JIRA_SERVICE_EMAIL=
AGENTOS_JIRA_SERVICE_TOKEN=
# Always admin: Jira account ids (DC: user keys) or emails, comma-separated, matched ignoring case.
# The first admin, and the way back in: they skip the Jira project check at sign-in.
AGENTOS_ADMINS=
# Behind a reverse proxy: trust CF-Connecting-IP / X-Forwarded-For for the login rate limit.
AGENTOS_TRUST_PROXY=0
