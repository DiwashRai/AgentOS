# Settings and secrets for the AgentOS container, passed with --env-file.
# Copy to backend/deploy/.env.container (gitignored by the `.env.*` rule); `just container-run`
# reads it from there. Plain KEY=value lines: no quotes, no inline comments (--env-file passes
# everything after `=` verbatim).
#
# The image already sets AGENTOS_HOST=0.0.0.0, AGENTOS_PORT=8000, AGENTOS_DATA_DIR=/data,
# AGENTOS_WEB_DIR=/app/web and AGENTOS_WORKSPACES_DIR=/workspaces. Everything else an admin may
# change is edited in the app (Settings) and stored in the db on the /data volume.

# The URL people open in the browser (the published host port; https behind a proxy).
# https:// also makes the session cookie Secure.
AGENTOS_PUBLIC_URL=http://127.0.0.1:8080
# What workers dial (defaults to PUBLIC_URL). Must be reachable from the runners, e.g. the
# Windows host IP from a WSL2 runner: http://<host-ip>:8080
# AGENTOS_WORKER_URL=

# Auth: Jira. Dev auth (AGENTOS_DEV_AUTH=1) cannot run in the container: it requires a loopback
# AGENTOS_HOST, and the container listens on 0.0.0.0.
AGENTOS_JIRA_URL=https://phaseonebig.atlassian.net
AGENTOS_JIRA_DEPLOYMENT=cloud
# Jira import ("Import from Jira" in the New ticket dialog): the service account the server reads
# issues with (Cloud: its email + a classic API token). Leave both empty to turn import off.
AGENTOS_JIRA_SERVICE_EMAIL=
AGENTOS_JIRA_SERVICE_TOKEN=
# Admins, comma-separated: Jira account ids or emails (matched ignoring case). Everyone else
# waits for an admin's approval after their first sign-in. Admins only need a valid Jira token:
# they set the Space's Jira projects (who else may sign in) in Settings > Space.
AGENTOS_ADMINS=
# Set to 1 behind a reverse proxy (CF-Connecting-IP / X-Forwarded-For for the login rate limit).
# AGENTOS_TRUST_PROXY=1

# The Space's name, key prefix, Jira projects, claim timeout, repos, intake queries, runtimes and
# the runner's GitHub repo/workflow/ref are edited in the app (Settings), not here.

# Runs go to GitHub Actions (README "GitHub Actions runner"): the container has no agent CLIs.
# The repo, workflow and ref are set in Settings > Runners.
AGENTOS_LAUNCHER=github
# A fine-grained PAT for that one repo with Actions: Read and write.
AGENTOS_GITHUB_TOKEN=
# GitHub Enterprise Server only (default https://api.github.com):
# AGENTOS_GITHUB_API_URL=https://ghe.example.com/api/v3

# Mailbox mode, for runners that can reach GitHub and Artifactory but not this server (README
# "Mailbox mode"): set AGENTOS_LAUNCHER=mailbox above (AGENTOS_WORKER_URL is then unused), keep
# AGENTOS_GITHUB_TOKEN, and point at an Artifactory generic folder (https, one per server
# instance; the same URL goes in the runner repo's AGENTOS_ARTIFACTORY_URL variable). The user
# needs read, deploy and delete there; the password may be an access token.
# AGENTOS_ARTIFACTORY_URL=https://artifactory.example.com/artifactory/generic-local/agentos
# AGENTOS_ARTIFACTORY_USER=
# AGENTOS_ARTIFACTORY_PASSWORD=
